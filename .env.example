# MongoDB Atlas Connection String (Private server-side only)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/griham99?retryWrites=true&w=majority
MONGODB_URI=

# Admin Authorization Secret Key (Private server-side only)
ADMIN_SECRET_KEY=

# NextAuth Secret for session encryption (Optional)
NEXTAUTH_SECRET=

# Razorpay Payment Gateway Credentials (Optional / Future integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary Image Upload (Required for Vercel / Production image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
